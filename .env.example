# Environment — API (required on Render and locally)
QDRANT_URL=https://your-cluster.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Comma-separated; add multiple keys for zero-downtime rotation
API_KEYS=your_secret_api_key_here

# Optional — defaults shown
QDRANT_COLLECTION=disaster_docs
GROQ_MODEL=openai/gpt-oss-20b
TOP_K=5
SCORE_THRESHOLD=0.30

# Optional — not needed initially; add when conversation history is required
# DATABASE_URL=postgresql://user:pass@host/db
