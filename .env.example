# ---------------------------------------------------------------------------
# DRCIP RAG API -- environment template.
# Copy to `.env` and fill in real values. `.env` is git-ignored; never commit it.
# On Render, set these in Dashboard -> Environment instead of using a file.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
ENV=development                 # development | test | production
LOG_LEVEL=INFO
# Serve /docs and /openapi.json. Keep true while integrating, false to hide schema.
DOCS_ENABLED=true

# --- Qdrant Cloud ----------------------------------------------------------
# Cluster URL, e.g. https://<cluster-id>.<region>.aws.cloud.qdrant.io:6333
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=drcip_disaster_docs_v1

# --- Embeddings ------------------------------------------------------------
# Must match a model listed as "Free" on your cluster's Inference tab.
# intfloat/multilingual-e5-small -> 384 dims, 512-token window.
EMBED_MODEL=intfloat/multilingual-e5-small
EMBED_DIM=384
# qdrant_cloud = embed on Qdrant's side (recommended on Render free tier).
# local        = fastembed on this machine, for offline development only.
EMBED_BACKEND=qdrant_cloud

# --- Groq ------------------------------------------------------------------
GROQ_API_KEY=
# Verified available on this account's free tier with strict JSON support.
GROQ_MODEL=qwen/qwen3.8-27b
# Used only if the primary model is unavailable; leave empty to disable.
GROQ_MODEL_FALLBACK=openai/gpt-oss-20b
GROQ_TIMEOUT_S=20

# --- Public API ------------------------------------------------------------
# Comma-separated. Two keys allow rotation without downtime.
# Generate: python -c "import secrets; print('drcip_' + secrets.token_urlsafe(32))"
API_KEYS=
RATE_LIMIT_PER_MIN=10
MAX_QUESTION_CHARS=500
TOP_K=6
MIN_SCORE=0.30
MAX_OUTPUT_TOKENS=700
REQUEST_TIMEOUT_S=25

# --- CORS ------------------------------------------------------------------
# Empty = no CORS (server-to-server only; this is the recommended setup).
ALLOWED_ORIGINS=

# --- Reserved (NOT used in v1) ---------------------------------------------
# NEON_DATABASE_URL=
